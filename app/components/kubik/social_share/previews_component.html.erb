<div class="<%= wrapper_classes %>">
  <% @platforms.each do |platform| %>
    <div class="kubik-social-share-previews__group">
      <h4 class="kubik-social-share-previews__heading"><%= heading_for(platform) %></h4>
      <%= render Kubik::SocialShare::PreviewComponent.new(meta: @meta, platform: platform) %>
    </div>
  <% end %>
</div>
