<section class="kubik-panel-audit" aria-label="<%= @aria_label %>">
  <h4 class="kubik-panel-audit__title"><%= @title %></h4>
  <% if @lead.present? %>
    <p class="kubik-panel-audit__lead"><%= @lead %></p>
  <% end %>
  <table class="kubik-panel-audit__table">
    <thead>
      <tr>
        <% @columns.each do |column| %>
          <th scope="col"><%= column[:label] %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @rows.each do |row| %>
        <tr>
          <% @columns.each do |column| %>
            <% cell = row[column[:key]] %>
            <% if cell.is_a?(Hash) %>
              <td class="<%= column[:cell_class] %>" title="<%= cell[:title] %>"><%= cell[:content] %></td>
            <% else %>
              <td class="<%= column[:cell_class] %>"><%= cell %></td>
            <% end %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
