<%# locals: url:, header:, label: nil, position: "end", html_class: "button", pending: false, icon: nil, tone: "grey" %>
<%
  label_text = local_assigns[:label].presence || header
  position = local_assigns.fetch(:position, "end")
  tone = local_assigns.fetch(:tone, "grey")
  icon_name = local_assigns[:icon]
%>
<%= tag.div(
      src: url,
      class: [html_class, ("kubik-offcanvas-open--pending" if pending)].compact.join(" "),
      role: "button",
      tabindex: 0,
      title: label_text,
      aria: { label: label_text },
      data: {
        kubik_offcanvas_header_text: header,
        kubik_offcanvas_position: position,
        kubik_offcanvas_tone: tone,
        action: "click->kubik-offcanvas#openOffcanvas"
      }
    ) do %>
  <% if pending %>
    <span class="kubik-offcanvas-open__badge" aria-hidden="true"></span>
  <% end %>
  <% if icon_name.present? %>
    <span class="material-symbols-outlined material-icon" aria-hidden="true"><%= icon_name %></span>
  <% else %>
    <%= label_text %>
  <% end %>
<% end %>
